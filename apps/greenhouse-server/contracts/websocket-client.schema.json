{
  "$defs": {
    "Control": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1",
          "title": "Api Version",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "start",
            "pause",
            "new_seed"
          ],
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "session_id",
        "generation",
        "kind",
        "request_id"
      ],
      "title": "Control",
      "type": "object"
    },
    "Ping": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1",
          "title": "Api Version",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "ping",
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "session_id",
        "generation",
        "kind",
        "request_id"
      ],
      "title": "Ping",
      "type": "object"
    },
    "Reset": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": "1",
          "title": "Api Version",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "reset",
          "title": "Kind",
          "type": "string"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "api_version",
        "session_id",
        "generation",
        "kind",
        "request_id"
      ],
      "title": "Reset",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "new_seed": "#/$defs/Control",
      "pause": "#/$defs/Control",
      "ping": "#/$defs/Ping",
      "reset": "#/$defs/Reset",
      "start": "#/$defs/Control"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Ping"
    },
    {
      "$ref": "#/$defs/Reset"
    },
    {
      "$ref": "#/$defs/Control"
    }
  ]
}
