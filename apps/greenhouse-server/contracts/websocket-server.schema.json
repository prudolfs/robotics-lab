    "Ack": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "title": "Accepted",
          "type": "boolean"
        },
        "api_version": {
          "const": "1",
          "title": "Api Version",
          "type": "string"
        },
        "command": {
          "enum": [
            "ping",
            "start",
            "pause",
            "reset",
            "new_seed",
            "set_controller",
            "manual",
            "record",
            "stop_recording"
          ],
          "title": "Command",
          "type": "string"
        },
        "generation": {
          "minimum": 0,
          "title": "Generation",
          "type": "integer"
        },
        "kind": {
          "const": "ack",
          "title": "Kind",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "stale_generation",
                "session_mismatch",
                "rate_limited",
                "invalid_state",
                "storage_error",
                "incompatible_checkpoint"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "request_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Request Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "tick": {
          "minimum": 0,
          "title": "Tick",
          "type": "integer"
        }
      },
      "required": [
        "api_version",
        "session_id",
        "generation",
        "tick",
        "kind",
        "request_id",
        "command",
        "accepted",
        "reason"
      ],
      "title": "Ack",
      "type": "object"
    },
