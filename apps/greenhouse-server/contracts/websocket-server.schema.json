  "discriminator": {
    "mapping": {
      "ack": "#/$defs/Ack",
      "error": "#/$defs/StreamError",
      "heartbeat": "#/$defs/Heartbeat",
      "hello": "#/$defs/Hello",
      "snapshot": "#/$defs/Snapshot"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/Hello"
    },
    {
      "$ref": "#/$defs/Snapshot"
    },
    {
      "$ref": "#/$defs/Heartbeat"
    },
    {
      "$ref": "#/$defs/Ack"
    },
