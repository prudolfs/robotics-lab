		"@tanstack/react-query": "^5.105.0",
		"@tanstack/react-table": "^9.3.1",
		"ajv": "8.20.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "^1.1.1",
		"lucide-react": "^1.23.0",
