{
	"name": "robotics-lab",
	"version": "1.0.0",
	"description": "",
	"keywords": [],
	"license": "ISC",
	"author": "",
	"type": "module",
	"main": "index.js",
	"scripts": {
		"lint": "biome lint",
		"format": "biome format --write",
		"check": "biome check --write --unsafe",
		"typecheck": "pnpm -r typecheck",
		"test": "vitest run",
		"test:e2e": "pnpm -C apps/simulator test:e2e",
		"test:e2e:soak": "pnpm -C apps/simulator test:e2e:soak",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"dev:slam": "pnpm -C apps/slam-demo dev",
		"screenshots:slam": "node scripts/capture-slam-views.mjs",
		"readme:gif": "node scripts/generate-readme-gif.mjs",
		"build:slam": "pnpm -C apps/slam-demo build",
		"test:e2e:slam": "pnpm -C apps/slam-demo test:e2e"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.2",
		"@vitest/ui": "^4.1.9",
		"typescript": "^7.0.2",
		"vitest": "^4.1.9"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.9.0",
			"onFail": "download"
		}
	}
}
